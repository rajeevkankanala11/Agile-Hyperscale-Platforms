### 2. `config.json`
*This file centralizes your testing endpoints so the Python scripts can read from it dynamically.*

```json
{
  "project_name": "agile-cloud-evaluation",
  "database_endpoints": {
    "aws_dynamodb": "dynamodb.us-east-1.amazonaws.com",
    "azure_cosmosdb": "mongodb://test-user:test-pwd@cosmos-agile-eval.documents.azure.com:10255",
    "gcp_firestore": "firestore.googleapis.com"
  },
  "network_vms_eu_west": {
    "aws_ec2_target": "3.120.15.22",
    "azure_vm_target": "51.140.88.11",
    "gcp_compute_target": "34.107.45.99"
  },
  "container_clusters": {
    "aws_fargate_cluster": "agile-benchmark-cluster",
    "azure_container_env": "agile-aca-env",
    "gcp_cloud_run_service": "agile-benchmark-service"
  },
  "benchmark_settings": {
    "ycsb_record_count": 1000000,
    "ycsb_operation_count": 10000000,
    "iperf_bandwidth_mbps": "200M",
    "iperf_duration_sec": 30
  }
}